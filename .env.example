# Copy to .env (never commit .env). Variables already set in the environment win.
DSPACE_URL=http://localhost:8080/server/api
DSPACE_USERNAME=admin@example.org
DSPACE_PASSWORD=change-me
DSPACE_VERSION=8

# Optional
# DSPACE_ALL_LANGUAGES=false
# DSPACE_TIMEOUT=30
# DSPACE_MAX_RETRIES=3
# DSPACE_RETRY_BACKOFF=1.0
# DSPACE_RETRY_MAX_WAIT=30
# DSPACE_RETRY_STATUSES=429,502,503,504
# DSPACE_TOKEN_REFRESH_MARGIN=60
# DSPACE_REAUTHENTICATE=true
# DSpace-CRIS: accept the end-user agreement for the logged-in user automatically
# DSPACE_ACCEPT_USER_AGREEMENT=false
